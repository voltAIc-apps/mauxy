# Sinks (flywheel SPEC-021): where confirmed data goes. LEAD_SINK odoo|none, SUBSCRIBER_SINK odoo|mautic|none
# (mautic = DEPRECATED, being retired; none = nothing stored, leads go to LEAD_NOTIFY_TO by mail)
LEAD_SINK=odoo
SUBSCRIBER_SINK=odoo

# erp.wapsol (Odoo 18) -- mauxy's OWN API user (website-bot), never a personal login. Same variable
# names as the flywheel read client, different user. https only (API key travels in the body).
ODOO_URL=https://erp.wapsol.de
ODOO_DB=pwo-18-prod
ODOO_USER=
ODOO_API_KEY=
ODOO_TIMEOUT=20
# Salesperson (Ashant) res.users id, also added as follower; optional CRM team id, tag ids (comma)
ODOO_LEAD_USER_ID=
ODOO_LEAD_TEAM_ID=
ODOO_LEAD_TAG_IDS=
# UTM records are mapped by exact name (bot cannot create them); campaign name = CTA kind
# (selfcheck, contact, inquiry, webinar, checkout)
ODOO_UTM_SOURCE=simplify-erp.de
ODOO_UTM_MEDIUM=Website
# Email Marketing lists (mailing.list ids)
ODOO_LIST_NEWSLETTER_ID=
ODOO_LIST_RADAR_ID=

# CTA leads (POST /api/lead). Origins default to SELFCHECK_ALLOWED_ORIGINS; website default to
# PUBLIC_WEBSITE_BASE_URL. LEAD_NOTIFY_TO (default SELFCHECK_NOTIFY_TO) gets failed deliveries.
LEAD_ALLOWED_ORIGINS=
LEAD_WEBSITE_URL=
LEAD_RATE_LIMIT=5/minute
LEAD_NOTIFY_TO=
LEAD_PENDING_DAYS=7
LEAD_RETENTION_DAYS=30
# Outbox retries: attempts and base backoff (seconds, doubled per attempt, max 1 h)
LEAD_SYNC_MAX_ATTEMPTS=6
LEAD_SYNC_BACKOFF_SECONDS=60
SHUTDOWN_DRAIN_SECONDS=10

# DEPRECATED Mautic (only with SUBSCRIBER_SINK=mautic)
MAUTIC_BASE_URL=https://mautic.example.com
MAUTIC_USERNAME=
MAUTIC_PASSWORD=
# Target Mautic version (manual). Persisted in SQLite, shown in /health/detail, and
# resolved via get_mautic_version() for future version-specific API branching. Leave
# empty if unknown; can also be set at runtime via PUT /api/admin/mautic-instance.
MAUTIC_VERSION=
# CORS origins of the calling sites (prod e.g. https://simplify-erp.de,https://www.simplify-erp.de,https://ludo.de;
# dev adds http://10.0.99.1:5182). They call https://mauxy.engage.wapsol.de (PUBLIC_BASE_URL).
ALLOWED_ORIGINS=https://your-app.example.com
RATE_LIMIT=5/minute
CONFIRM_RATE_LIMIT=30/minute
# per-IP limits of POST /api/subscribe (behind the quiz; mails per address capped separately) and GET /api/challenge
SUBSCRIBE_RATE_LIMIT=60/minute
CHALLENGE_RATE_LIMIT=30/minute
ACTION_LOG_DB=/data/actions.db
# Refuse to start when the DB schema is behind the shipped db-patches/ (default true).
# Set false to start with a warning instead. Patches are applied by the deployer via
# `python scripts/sqlite_db.py --migrate` (k8s runs this as an initContainer).
MIGRATE_STRICT=true
# Bearer token for the admin endpoints (/api/actions, /api/admin/*, /api/lead/submissions, ...).
# Disabled (403) while unset.
ADMIN_API_KEY=

# Newsletter authority: per-site registry. SEED ONLY: at runtime the registry lives in SQLite
# (sites table, /api/admin/sites); this var only seeds an EMPTY table on first boot.
# JSON array, one object per calling site. The Bearer `key` identifies the site; `segment`
# (Mautic segment alias, used by the deprecated Mautic sink only) and `topic` (quiz bank) come
# from here, never from the request body. Topics: db-patches/0002_seed_quiz.sql.
# MAUXY_SITES=[{"key":"CHANGE-ME-simplify","site":"simplify-erp","segment":"simplify-erp","topic":"simplify-erp"},{"key":"CHANGE-ME-ludo","site":"ludo","segment":"ludo","topic":"ludo"}]
MAUXY_SITES=[]
# HMAC secret of the bot-defence quiz tokens; unset = quiz and so newsletter (un)subscribe disabled.
# Quiz content: db-patches/0002_seed_quiz.sql, edited at runtime via /api/admin/quiz.
CHALLENGE_SECRET=
CHALLENGE_TTL=600

# Newsletter double opt-in
# Sign the confirmation token. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CONFIRM_TOKEN_SECRET=
CONFIRM_TOKEN_MAX_AGE=86400
# Public base URL of this mauxy instance; base of the confirm link in the DOI mail
# (prod: https://mauxy.engage.wapsol.de, the canonical host; must be the host of the LinkedIn redirect URI
# and the site's VITE_MAUXY_URL). Every confirm link and the LinkedIn callback derive from it.
PUBLIC_BASE_URL=
# Public base URL of the website; confirm endpoint redirects here on success/error
# (e.g. https://simplify-erp.de). Must not include a trailing slash.
PUBLIC_WEBSITE_BASE_URL=
# Unconfirmed newsletter requests are deleted after N days; max DOI mails per address / 24h
NEWSLETTER_PENDING_DAYS=7
MAX_PENDING_PER_EMAIL=3

# Mail -- the one mail path (mailer.py): DOI links, self-check result (+ report PDF / images),
# operator notifications. SMTP via mailcow. MAIL_MODE: smtp (default) | console (DEV ONLY, prints the
# body) | memory (tests). TLS is mandatory (certificate + hostname verified); there is no plaintext mode.
MAIL_MODE=smtp
SMTP_HOST=mail.mc1.simplify-erp.de
# starttls (port 587, default) or ssl (implicit TLS, port 465); STARTTLS not offered -> mail refused
SMTP_SECURITY=starttls
SMTP_PORT=587
# mailcow mailbox of the sender + its app password (never a personal login password)
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ashant Chalasani <ach@simplify-erp.de>
SMTP_REPLY_TO=
SMTP_TIMEOUT=30
# extra trust anchor for a LOCAL mock server only (tests); leave empty in stag / prod
SMTP_CA_FILE=
# limits: total size per mail, allowed attachment types, mails per recipient and hour (internal exempt)
MAIL_MAX_BYTES=10485760
MAIL_ATTACHMENT_TYPES=application/pdf,image/png,image/jpeg,image/webp
MAIL_RECIPIENT_HOURLY_LIMIT=10
# extra internal recipients (besides SELFCHECK_NOTIFY_TO / LEAD_NOTIFY_TO), comma-separated
MAIL_INTERNAL_RECIPIENTS=
# retries: attempts, base backoff (s, doubled per attempt); outbox rows kept N days
MAIL_MAX_ATTEMPTS=4
MAIL_BACKOFF_SECONDS=30
MAIL_RETENTION_DAYS=7

# Selbst-Check (simplify-erp.de /:lang/selbst-check, flywheel SPEC-020)
# Origins allowed to POST /api/selfcheck and /api/selfcheck/event (prod: https://simplify-erp.de;
# dev adds http://10.0.99.1:5182). Must also be in ALLOWED_ORIGINS (CORS).
SELFCHECK_ALLOWED_ORIGINS=
# Website base for the confirm redirect (/{lang}/selbst-check?bestaetigt=1); default from the rules file
SELFCHECK_WEBSITE_URL=
# Operator mailbox for "Richtangebot / Kennenlernen" notifications
SELFCHECK_NOTIFY_TO=
SELFCHECK_RATE_LIMIT=5/minute
SELFCHECK_EVENT_RATE_LIMIT=600/minute
# Retention: unconfirmed submissions / confirmed submissions (days)
SELFCHECK_PENDING_DAYS=7
SELFCHECK_RETENTION_DAYS=90
# Name required on POST /api/selfcheck (db-patches/0010). Rollout: deploy mauxy with false (the live
# website does not send name yet), then the website, then true. false only tolerates a MISSING name.
SELFCHECK_NAME_REQUIRED=true
# Salutation (ms / mr / none) required on POST /api/selfcheck (db-patches/0012). Same rollout: false
# first (live website does not send it yet; missing = "none"), then the website, then true.
SELFCHECK_SALUTATION_REQUIRED=true
# DEPRECATED: Migration Radar in Mautic (only with SUBSCRIBER_SINK=mautic): tag, optional segment id
MAUTIC_RADAR_TAG=migration_radar_confirmed
MAUTIC_RADAR_SEGMENT_ID=
# Optional override of the vendored rules file
SELFCHECK_RULES_FILE=

# Website visitor LinkedIn login (sign-in only, replaces app2li). LinkedIn app of simplify-erp.de:
# product "Sign In with LinkedIn using OpenID Connect", redirect URL exactly
# https://mauxy.engage.wapsol.de/api/auth/linkedin/callback. Client secret = k8s secret only.
# Missing / unsafe values disable only the login (/health/detail auth_linkedin).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# default: PUBLIC_BASE_URL + /api/auth/linkedin/callback (same host as the start endpoint: cookie)
LINKEDIN_REDIRECT_URI=
# sites the login returns to (default LEAD_ALLOWED_ORIGINS); https only (http only on 10.0.99.1)
AUTH_ALLOWED_ORIGINS=
# >= 32 chars, signs state + session (default CONFIRM_TOKEN_SECRET with own salts)
AUTH_TOKEN_SECRET=
AUTH_SESSION_TTL=3600
AUTH_RATE_LIMIT=20/minute
AUTH_SESSION_RATE_LIMIT=30/minute

# Deployment (used by scripts/deploy.py — render/apply manifests, build/push, secret).
DEPLOY_NAMESPACE=mauxy
DEPLOY_IMAGE=your-registry/mauxy:latest
DEPLOY_DOMAIN=mauxy.engage.wapsol.de
DEPLOY_IMAGE_PULL_SECRET=your-pull-secret

# Container registry for `deploy.py --build` (docker login + build + push).
REGISTRY_URL=your-registry
REGISTRY_USER=
REGISTRY_PASSWORD=

# Per site (owner requirement 2026-11-09, db-patches/0006): brand profiles + action routing live in
# SQLite (admin CRUD /api/admin/brands, /api/admin/routes); only these process settings are env.
# Site of CTA leads / Selbst-Checks whose Origin is not mapped in a brand profile (site_origin)
DEFAULT_SITE=simplify-erp
# Max size of a brand logo (PNG / WebP only, stored in SQLite, served as data: URI)
BRAND_LOGO_MAX_BYTES=65536
# Domains a brand profile may use as mail sender (comma-separated; default = SMTP_FROM's domain only).
# mailcow must allow SMTP_USER to send as these addresses; SPF / DKIM / DMARC per domain.
MAIL_SENDER_DOMAINS=simplify-erp.de
# Webhook targets (routing sink "webhook"): exact host names allowed (SSRF guard; empty = no webhook).
# https only, public addresses only, redirects never followed.
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_TIMEOUT=10
# One HMAC secret per webhook target (params.secret_ref "flywheel" -> WEBHOOK_SECRET_FLYWHEEL), >= 32 chars:
#   openssl rand -hex 32
# WEBHOOK_SECRET_FLYWHEEL=
# Re-signup after an own opt-out: at most one DOI mail per site and address in N days (abuse guard)
OPTOUT_RESIGNUP_DAYS=30
# Extra CA for a LOCAL mock receiver only (tests); leave empty in stag / prod
WEBHOOK_CA_FILE=
