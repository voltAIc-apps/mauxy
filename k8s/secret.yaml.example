# Template only -- DO NOT commit real values.
# Create the secret with:
#   kubectl create secret generic mauxy-credentials \
#     --from-literal=LEAD_SINK=odoo \
#     --from-literal=SUBSCRIBER_SINK=odoo \
#     --from-literal=ODOO_URL=https://erp.wapsol.de \
#     --from-literal=ODOO_DB=pwo-18-prod \
#     --from-literal=ODOO_USER=<website-bot login> \
#     --from-literal=ODOO_API_KEY=<website-bot API key> \
#     --from-literal=ODOO_LEAD_USER_ID=<Ashant res.users id> \
#     --from-literal=ODOO_LIST_NEWSLETTER_ID=<mailing.list id> \
#     --from-literal=ODOO_LIST_RADAR_ID=<mailing.list id> \
#     --from-literal=LEAD_ALLOWED_ORIGINS=https://simplify-erp.de \
#     --from-literal=LEAD_NOTIFY_TO=<Ashant mailbox> \
#     --from-literal=ADMIN_API_KEY=<key> \
#     --from-literal=CONFIRM_TOKEN_SECRET=<48+ random bytes> \
#     --from-literal=PUBLIC_BASE_URL=https://unsubscribe.engage.wapsol.de \
#     --from-literal=PUBLIC_WEBSITE_BASE_URL=https://simplify-erp.de \
#     --from-literal=SMTP_HOST=mail.mc1.simplify-erp.de \
#     --from-literal=SMTP_SECURITY=starttls \
#     --from-literal=SMTP_PORT=587 \
#     --from-literal=SMTP_USER=<sender mailbox> \
#     --from-literal=SMTP_PASSWORD=<mailcow app password> \
#     --from-literal=SMTP_FROM="<Name> <sender address>" \
#     --from-literal=SMTP_REPLY_TO=<reply address> \
#     --from-literal=SMTP_TIMEOUT=30 \
#     --from-literal=MAIL_MODE=smtp \
#     --from-literal=ALLOWED_ORIGINS=https://simplify-erp.de,https://ludo.de \
#     --from-literal=SELFCHECK_ALLOWED_ORIGINS=https://simplify-erp.de \
#     --from-literal=SELFCHECK_NOTIFY_TO=<operator mailbox> \
#     --from-literal=LINKEDIN_CLIENT_ID=<LinkedIn app client id> \
#     --from-literal=LINKEDIN_CLIENT_SECRET=<LinkedIn app client secret> \
#     --from-literal=AUTH_ALLOWED_ORIGINS=https://simplify-erp.de,https://www.simplify-erp.de \
#     --from-literal=AUTH_TOKEN_SECRET=<48+ random bytes, not the confirm secret> \
#     --from-literal=CHALLENGE_SECRET=<48+ random bytes, own secret> \
#     --from-literal=MAUXY_SITES='[{"key":"<simplify-key>","site":"simplify-erp","segment":"simplify-erp","topic":"simplify-erp"}]' \
#     -n ${DEPLOY_NAMESPACE}
# Optional mail limits: MAIL_MAX_BYTES, MAIL_ATTACHMENT_TYPES, MAIL_RECIPIENT_HOURLY_LIMIT,
# MAIL_INTERNAL_RECIPIENTS, MAIL_MAX_ATTEMPTS, MAIL_BACKOFF_SECONDS, MAIL_RETENTION_DAYS (never SMTP_CA_FILE).
# Optional: ODOO_LEAD_TEAM_ID, ODOO_LEAD_TAG_IDS, ODOO_UTM_SOURCE, ODOO_UTM_MEDIUM, LEAD_SYNC_*.
# DEPRECATED (only with SUBSCRIBER_SINK=mautic): MAUTIC_BASE_URL, MAUTIC_USERNAME, MAUTIC_PASSWORD,
# MAUTIC_RADAR_SEGMENT_ID.
apiVersion: v1
kind: Secret
metadata:
  name: mauxy-credentials
  namespace: ${DEPLOY_NAMESPACE}
type: Opaque
stringData:
  LEAD_SINK: "odoo"
  SUBSCRIBER_SINK: "odoo"
  ODOO_URL: "https://erp.wapsol.de"
  ODOO_DB: "pwo-18-prod"
  ODOO_USER: ""
  ODOO_API_KEY: ""
  ODOO_LEAD_USER_ID: ""
  ODOO_LIST_NEWSLETTER_ID: ""
  ODOO_LIST_RADAR_ID: ""
  LEAD_ALLOWED_ORIGINS: ""
  LEAD_NOTIFY_TO: ""
  ADMIN_API_KEY: ""
  CONFIRM_TOKEN_SECRET: ""
  PUBLIC_BASE_URL: ""
  PUBLIC_WEBSITE_BASE_URL: ""
  SMTP_HOST: "mail.mc1.simplify-erp.de"
  SMTP_SECURITY: "starttls"
  SMTP_PORT: "587"
  SMTP_USER: ""
  SMTP_PASSWORD: ""
  SMTP_FROM: ""
  SMTP_REPLY_TO: ""
  SMTP_TIMEOUT: "30"
  MAIL_MODE: "smtp"
  SELFCHECK_ALLOWED_ORIGINS: ""
  SELFCHECK_NOTIFY_TO: ""
  LINKEDIN_CLIENT_ID: ""
  LINKEDIN_CLIENT_SECRET: ""
  AUTH_ALLOWED_ORIGINS: ""
  AUTH_TOKEN_SECRET: ""
  CHALLENGE_SECRET: ""
  ALLOWED_ORIGINS: ""
  # JSON array of {key, site, segment, topic} -- seed only, see .env.example.
  MAUXY_SITES: "[]"
