{
  "suite": "POST /api/selfcheck validation (flywheel SPEC-020)",
  "description": "Each case patches the valid base payload (set / delete keys) and sends it with the given Origin. expect_status is the HTTP status; expect_mail whether a DOI mail goes out; expect_row whether a submission is stored. Optional: flag (SELFCHECK_NAME_REQUIRED for this case, default true) and expect_stored (columns of the stored row, after cleaning). String values {xN} are expanded to N times x. T-SC-160..183: name / phone (owner request 2026-11-09, db-patches/0010). T-SC-200..213: salutation (db-patches/0012); salutation_flag = SELFCHECK_SALUTATION_REQUIRED for this case (default true).",
  "base": {
    "email": "bob@example.com",
    "salutation": "none",
    "name": "Bob Beispiel",
    "lang": "de",
    "picks": ["mail", "call", "radar"],
    "answers": { "system": ["ecc"], "why": ["eol"], "s4": "no", "when": "12" },
    "rules_version": "2026-11-08.1",
    "consent": true
  },
  "cases": [
    { "id": "T-SC-101", "name": "valid partial submission, all three picks", "set": {}, "expect_status": 200, "expect_mail": true, "expect_row": true },
    { "id": "T-SC-102", "name": "consent false", "set": { "consent": false }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-103", "name": "unknown question id", "set": { "answers": { "foo": "x" } }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-104", "name": "unknown pick", "set": { "picks": ["mail", "offer"] }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-105", "name": "no pick", "set": { "picks": [] }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-106", "name": "duplicate pick", "set": { "picks": ["mail", "mail"] }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-107", "name": "exclusive option combined", "set": { "answers": { "why": ["none", "eol"] } }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-108", "name": "unexpected extra field", "set": { "price": 1000 }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-109", "name": "negative stay figure", "set": { "stay": { "licence": -1 } }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-110", "name": "invalid e-mail", "set": { "email": "bob@" }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-111", "name": "foreign origin", "origin": "https://evil.test", "set": {}, "expect_status": 403, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-112", "name": "no origin header", "origin": null, "set": {}, "expect_status": 403, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-113", "name": "honeypot filled: looks like success", "set": { "company_website": "http://spam" }, "expect_status": 200, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-114", "name": "unsupported language", "set": { "lang": "fr" }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-115", "name": "oversized answer value", "set": { "answers": { "when": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" } }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-116", "name": "valid with stage 2 figures", "set": { "stay": { "licence": 120000, "support": 30000, "users": 60 } }, "expect_status": 200, "expect_mail": true, "expect_row": true },
    { "id": "T-SC-117", "name": "consent missing", "delete": ["consent"], "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-160", "name": "name missing, SELFCHECK_NAME_REQUIRED on (default)", "set": {}, "delete": ["name"], "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-161", "name": "name missing, SELFCHECK_NAME_REQUIRED off (rollout transition): accepted, stored NULL", "set": {}, "delete": ["name"], "flag": false, "expect_status": 200, "expect_mail": true, "expect_row": true, "expect_stored": { "name": null, "phone": null } },
    { "id": "T-SC-162", "name": "name blank (spaces only)", "set": { "name": "   " }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-163", "name": "name blank is refused even with SELFCHECK_NAME_REQUIRED off", "set": { "name": "  " }, "flag": false, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-164", "name": "name of control characters only", "set": { "name": "\u0000\u0007\u001b" }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-165", "name": "name exactly 100 characters", "set": { "name": "Maximiliane xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" }, "expect_status": 200, "expect_mail": true, "expect_row": true, "expect_stored": { "name": "Maximiliane xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" } },
    { "id": "T-SC-166", "name": "name 101 characters", "set": { "name": "Maximiliane xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-167", "name": "control characters stripped, line breaks / tabs become one space", "set": { "name": "  Bob\u0000 Bei\nspiel\t\r\n" }, "expect_status": 200, "expect_mail": true, "expect_row": true, "expect_stored": { "name": "Bob Bei spiel" } },
    { "id": "T-SC-168", "name": "direction override removed", "set": { "name": "Bob \u202eleipsieB\u2066" }, "expect_status": 200, "expect_mail": true, "expect_row": true, "expect_stored": { "name": "Bob leipsieB" } },
    { "id": "T-SC-169", "name": "100 characters plus surrounding whitespace: trimmed, accepted", "set": { "name": "   Maximiliane xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   " }, "expect_status": 200, "expect_mail": true, "expect_row": true, "expect_stored": { "name": "Maximiliane xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" } },
    { "id": "T-SC-170", "name": "name far over the raw cap (500)", "set": { "name": "{x500}" }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-171", "name": "name not a string", "set": { "name": 123 }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-172", "name": "umlauts, apostrophe, hyphen kept", "set": { "name": "Jörg O'Brien-Müller" }, "expect_status": 200, "expect_mail": true, "expect_row": true, "expect_stored": { "name": "Jörg O'Brien-Müller" } },
    { "id": "T-SC-173", "name": "phone valid with + ( ) / - and spaces", "set": { "phone": "+49 (0)30 / 123-45" }, "expect_status": 200, "expect_mail": true, "expect_row": true, "expect_stored": { "phone": "+49 (0)30 / 123-45" } },
    { "id": "T-SC-174", "name": "phone absent", "set": {}, "expect_status": 200, "expect_mail": true, "expect_row": true, "expect_stored": { "name": "Bob Beispiel", "phone": null } },
    { "id": "T-SC-175", "name": "phone empty string = absent", "set": { "phone": "  " }, "expect_status": 200, "expect_mail": true, "expect_row": true, "expect_stored": { "phone": null } },
    { "id": "T-SC-176", "name": "phone with letters", "set": { "phone": "+49 30 abc" }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-177", "name": "phone with a dot (not in the charset)", "set": { "phone": "030.1234" }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-178", "name": "phone exactly 40 characters", "set": { "phone": "0000000000000000000000000000000000000000" }, "expect_status": 200, "expect_mail": true, "expect_row": true, "expect_stored": { "phone": "0000000000000000000000000000000000000000" } },
    { "id": "T-SC-179", "name": "phone 41 characters", "set": { "phone": "00000000000000000000000000000000000000000" }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-180", "name": "phone without any digit", "set": { "phone": "+()/-" }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-181", "name": "phone with an inner line break", "set": { "phone": "030\n123" }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-182", "name": "phone trimmed", "set": { "phone": " 030 123 " }, "expect_status": 200, "expect_mail": true, "expect_row": true, "expect_stored": { "phone": "030 123" } },
    { "id": "T-SC-183", "name": "invalid phone refused even with SELFCHECK_NAME_REQUIRED off and no name", "set": { "phone": "x" }, "delete": ["name"], "flag": false, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-200", "name": "salutation ms", "set": { "salutation": "ms" }, "expect_status": 200, "expect_mail": true, "expect_row": true, "expect_stored": { "salutation": "ms" } },
    { "id": "T-SC-201", "name": "salutation mr", "set": { "salutation": "mr" }, "expect_status": 200, "expect_mail": true, "expect_row": true, "expect_stored": { "salutation": "mr" } },
    { "id": "T-SC-202", "name": "salutation none (Keine Angabe)", "set": { "salutation": "none" }, "expect_status": 200, "expect_mail": true, "expect_row": true, "expect_stored": { "salutation": "none" } },
    { "id": "T-SC-203", "name": "salutation missing, flag on", "set": {}, "delete": ["salutation"], "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-204", "name": "salutation missing, flag off: stored as none", "set": {}, "delete": ["salutation"], "salutation_flag": false, "expect_status": 200, "expect_mail": true, "expect_row": true, "expect_stored": { "salutation": "none" } },
    { "id": "T-SC-205", "name": "salutation null, flag on", "set": { "salutation": null }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-206", "name": "salutation null, flag off: stored as none", "set": { "salutation": null }, "salutation_flag": false, "expect_status": 200, "expect_mail": true, "expect_row": true, "expect_stored": { "salutation": "none" } },
    { "id": "T-SC-207", "name": "salutation unknown value", "set": { "salutation": "mrs" }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-208", "name": "salutation upper case (enum is exact)", "set": { "salutation": "MS" }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-209", "name": "salutation empty string", "set": { "salutation": "" }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-210", "name": "salutation unknown value refused even with the flag off", "set": { "salutation": "divers" }, "salutation_flag": false, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-211", "name": "salutation as a number", "set": { "salutation": 1 }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-212", "name": "salutation as a list", "set": { "salutation": ["ms"] }, "expect_status": 422, "expect_mail": false, "expect_row": false },
    { "id": "T-SC-213", "name": "old website: no salutation, no name, both flags off", "set": {}, "delete": ["salutation", "name"], "flag": false, "salutation_flag": false, "expect_status": 200, "expect_mail": true, "expect_row": true, "expect_stored": { "name": null, "salutation": "none" } }
  ]
}
