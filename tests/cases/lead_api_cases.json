{
  "suite": "POST /api/lead validation (flywheel SPEC-021)",
  "description": "Each case takes the valid base payload of its kind, patches it (set / delete keys) and sends it with the given Origin (default https://site.test; null = no header). expect_status is the HTTP status; expect_mail whether ONE DOI mail goes out; expect_row whether a submission is stored. '{future}' in a value is replaced by a date 30 days ahead (ISO, UTC). No case may reach Odoo (asserted for every case).",
  "base": {
    "contact": {"kind": "contact", "email": "bob@example.com", "lang": "de", "name": "Bob Muster", "company": "Muster GmbH",
                "phone": "+49 30 1234567", "message": "Wir planen den Wechsel von SAP ECC.\nBitte um Rückruf."},
    "inquiry": {"kind": "inquiry", "email": "bob@example.com", "lang": "de", "name": "Bob Muster", "subject_type": "app",
                "subject_id": "odoo-datalake", "subject_title": "Odoo Datalake"},
    "webinar": {"kind": "webinar", "email": "bob@example.com", "lang": "en", "name": "Bob Muster", "company": "Muster GmbH",
                "webinar_id": "odoo-ki", "webinar_title": "KI in Odoo", "date": "{future}"},
    "checkout": {"kind": "checkout", "email": "bob@example.com", "lang": "de", "name": "Bob Muster", "company": "Muster GmbH",
                 "product_id": "invoice-ocr", "product_title": "Invoice OCR", "bundle": "Starter", "services": ["Installation"],
                 "price_net": 1490.0, "currency": "EUR", "order_ref": "ORD-ABC123",
                 "billing": {"street": "Hauptstr. 1", "postal_code": "10115", "city": "Berlin", "country": "DE"},
                 "vat_id": "DE123456789", "terms": true}
  },
  "cases": [
    {"id": "T-LEAD-001", "kind": "contact", "name": "valid contact", "set": {}, "expect_status": 200, "expect_mail": true, "expect_row": true},
    {"id": "T-LEAD-002", "kind": "contact", "name": "contact with newsletter", "set": {"newsletter": true, "page_url": "https://site.test/de/contact"}, "expect_status": 200, "expect_mail": true, "expect_row": true},
    {"id": "T-LEAD-003", "kind": "contact", "name": "message missing", "delete": ["message"], "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-004", "kind": "contact", "name": "message too long", "set": {"message": "{x4001}"}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-005", "kind": "contact", "name": "control character in name", "set": {"name": "Bob\u0007"}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-006", "kind": "contact", "name": "phone with letters", "set": {"phone": "call me maybe"}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-007", "kind": "contact", "name": "unexpected field", "set": {"budget": 100000}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-008", "kind": "contact", "name": "page_url on foreign origin", "set": {"page_url": "https://evil.test/x"}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-009", "kind": "contact", "name": "foreign origin", "origin": "https://evil.test", "set": {}, "expect_status": 403, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-010", "kind": "contact", "name": "no origin header", "origin": null, "set": {}, "expect_status": 403, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-011", "kind": "contact", "name": "honeypot filled: looks like success", "set": {"company_website": "http://spam"}, "expect_status": 200, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-012", "kind": "contact", "name": "invalid e-mail", "set": {"email": "bob@"}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-013", "kind": "contact", "name": "unknown kind", "set": {"kind": "quote"}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-014", "kind": "contact", "name": "unsupported language", "set": {"lang": "fr"}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-015", "kind": "inquiry", "name": "valid inquiry, name / company optional", "set": {}, "expect_status": 200, "expect_mail": true, "expect_row": true},
    {"id": "T-LEAD-016", "kind": "inquiry", "name": "subject id with spaces", "set": {"subject_id": "odoo datalake"}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-017", "kind": "inquiry", "name": "unknown subject type", "set": {"subject_type": "rocket"}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-018", "kind": "webinar", "name": "valid webinar registration", "set": {}, "expect_status": 200, "expect_mail": true, "expect_row": true},
    {"id": "T-LEAD-019", "kind": "webinar", "name": "date without time zone", "set": {"date": "2030-01-01T10:00:00"}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-020", "kind": "webinar", "name": "date far in the past", "set": {"date": "2020-01-01T10:00:00Z"}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-021", "kind": "webinar", "name": "company missing", "delete": ["company"], "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-022", "kind": "checkout", "name": "valid checkout", "set": {}, "expect_status": 200, "expect_mail": true, "expect_row": true},
    {"id": "T-LEAD-023", "kind": "checkout", "name": "terms not accepted", "set": {"terms": false}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-024", "kind": "checkout", "name": "negative price", "set": {"price_net": -1}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-025", "kind": "checkout", "name": "malformed order reference", "set": {"order_ref": "ORDER-1; DROP"}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-026", "kind": "checkout", "name": "country not ISO-2", "set": {"billing": {"street": "Hauptstr. 1", "postal_code": "10115", "city": "Berlin", "country": "Germany"}}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-027", "kind": "checkout", "name": "foreign currency", "set": {"currency": "USD"}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-028", "kind": "checkout", "name": "too many services", "set": {"services": ["s1","s2","s3","s4","s5","s6","s7","s8","s9","s10","s11","s12","s13","s14","s15","s16","s17","s18","s19","s20","s21"]}, "expect_status": 422, "expect_mail": false, "expect_row": false},
    {"id": "T-LEAD-029", "kind": "checkout", "name": "malformed VAT id", "set": {"vat_id": "123"}, "expect_status": 422, "expect_mail": false, "expect_row": false}
  ]
}
