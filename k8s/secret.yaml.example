# Template only -- DO NOT commit real values.
# Create the secret with:
#   kubectl create secret generic mauxy-credentials \
#     --from-literal=MAUTIC_BASE_URL=https://mautic.example.com \
#     --from-literal=MAUTIC_USERNAME=<user> \
#     --from-literal=MAUTIC_PASSWORD=<pass> \
#     --from-literal=ADMIN_API_KEY=<key> \
#     --from-literal=CHALLENGE_SECRET=<random-32-bytes> \
#     --from-literal=ALLOWED_ORIGINS=https://ludo.de,https://www.simplify-erp.de \
#     --from-literal=MAUXY_SITES='[{"key":"<ludo-key>","site":"ludo","segment":"ludo","topic":"odoo"}]' \
#     -n ${DEPLOY_NAMESPACE}
apiVersion: v1
kind: Secret
metadata:
  name: mauxy-credentials
  namespace: ${DEPLOY_NAMESPACE}
type: Opaque
stringData:
  MAUTIC_BASE_URL: ""
  MAUTIC_USERNAME: ""
  MAUTIC_PASSWORD: ""
  ADMIN_API_KEY: ""
  CHALLENGE_SECRET: ""
  ALLOWED_ORIGINS: ""
  # JSON array of {key, site, segment, topic} — see .env.example.
  MAUXY_SITES: "[]"
