{
  "suite": "Per-site brand profile + action routing + signed webhook sink (owner requirement 2026-11-09, db-patches/0006)",
  "description": "brand_admin: PUT /api/admin/brands/brand-x with body -> status (a fresh site each case; 'error' = substring of the 400 error). Logo data tokens: $PNG (valid 1x1 PNG), $WEBP (valid WebP header), $JPEG (JPEG bytes), $PNG_BIG (PNG > BRAND_LOGO_MAX_BYTES), $NOT_B64. Env: MAIL_SENDER_DOMAINS=site.test,re-cloud.test. xss: profile field set to value, the rendered confirmation page must contain 'escaped' and must not contain 'raw'. route_admin: PUT /api/admin/routes/brand-x/<action> {targets} -> status; env WEBHOOK_ALLOWED_HOSTS=hooks.test,flywheel.test, WEBHOOK_SECRET_FLYWHEEL set (>= 32 chars), WEBHOOK_SECRET_SHORT too short, WEBHOOK_SECRET_MISSING unset. ssrf: webhooks.deliver with params {url, secret_ref: flywheel}, the resolver answers 'resolve' -> expect ok (one signed POST reaches the pinned address) | permanent (SinkPermanent, nothing sent) ; admin = status of PUT routes with that URL. responses: the receiver answers 'status' (or 'timeout') -> ok | transient | permanent, 'requests' = how many requests were sent (redirects never followed).",
  "brand_admin": [
    {"id": "T-BR-001", "name": "minimal profile", "body": {"display_name": "Re-Cloud"}, "status": 201},
    {"id": "T-BR-002", "name": "full profile", "body": {"display_name": "Re-Cloud", "legal_entity": "wapsol GmbH", "color_primary": "#112233", "color_accent": "#AABBCC", "wordmark": "re-cloud", "website_url": "https://re-cloud.test", "imprint_url": "https://re-cloud.test/{lang}/impressum", "privacy_url": "https://re-cloud.test/{lang}/datenschutz", "default_locale": "en", "mail_from_name": "Re-Cloud Team", "mail_from_address": "hello@re-cloud.test", "mail_reply_to": "info@re-cloud.test", "mail_footer": {"de": "Re-Cloud\nwapsol GmbH", "en": "Re-Cloud\nwapsol GmbH"}, "redirects": [{"flow": "newsletter", "locale": "de", "outcome": "confirmed", "url": "https://re-cloud.test/de/danke"}], "origins": ["https://re-cloud.test"], "logo": {"mime": "image/png", "data": "$PNG"}}, "status": 201},
    {"id": "T-BR-003", "name": "new profile needs display_name", "body": {"legal_entity": "x"}, "status": 400, "error": "display_name"},
    {"id": "T-BR-004", "name": "colour: 3-digit hex refused", "body": {"display_name": "X", "color_primary": "#fff"}, "status": 422},
    {"id": "T-BR-005", "name": "colour: CSS injection refused", "body": {"display_name": "X", "color_primary": "#000000;}body{background:url(x)"}, "status": 422},
    {"id": "T-BR-006", "name": "colour: name refused", "body": {"display_name": "X", "color_accent": "red"}, "status": 422},
    {"id": "T-BR-007", "name": "url: http refused", "body": {"display_name": "X", "website_url": "http://re-cloud.test"}, "status": 400, "error": "https only"},
    {"id": "T-BR-008", "name": "url: javascript: refused", "body": {"display_name": "X", "website_url": "javascript:alert(1)"}, "status": 400},
    {"id": "T-BR-009", "name": "url: user info refused", "body": {"display_name": "X", "website_url": "https://user@re-cloud.test"}, "status": 400, "error": "user info"},
    {"id": "T-BR-010", "name": "url: quote / attribute break refused", "body": {"display_name": "X", "imprint_url": "https://re-cloud.test/\"onmouseover=alert(1)"}, "status": 400, "error": "forbidden character"},
    {"id": "T-BR-011", "name": "url: {lang} only in imprint / privacy / redirects", "body": {"display_name": "X", "website_url": "https://re-cloud.test/{lang}"}, "status": 400},
    {"id": "T-BR-012", "name": "url: {lang} placeholder in imprint ok", "body": {"display_name": "X", "imprint_url": "https://re-cloud.test/{lang}/imprint"}, "status": 201},
    {"id": "T-BR-013", "name": "url: http only on the dev loopback alias", "body": {"display_name": "X", "website_url": "http://10.0.99.1:5182"}, "status": 201},
    {"id": "T-BR-014", "name": "url: http on another private host refused", "body": {"display_name": "X", "website_url": "http://192.168.1.5"}, "status": 400},
    {"id": "T-BR-015", "name": "logo: PNG ok", "body": {"display_name": "X", "logo": {"mime": "image/png", "data": "$PNG"}}, "status": 201},
    {"id": "T-BR-016", "name": "logo: WebP ok", "body": {"display_name": "X", "logo": {"mime": "image/webp", "data": "$WEBP"}}, "status": 201},
    {"id": "T-BR-017", "name": "logo: SVG refused (script vector)", "body": {"display_name": "X", "logo": {"mime": "image/svg+xml", "data": "PHN2Zz48L3N2Zz4="}}, "status": 422},
    {"id": "T-BR-018", "name": "logo: bytes must match the type", "body": {"display_name": "X", "logo": {"mime": "image/png", "data": "$JPEG"}}, "status": 400, "error": "does not match"},
    {"id": "T-BR-019", "name": "logo: size cap", "body": {"display_name": "X", "logo": {"mime": "image/png", "data": "$PNG_BIG"}}, "status": 400, "error": "bytes"},
    {"id": "T-BR-020", "name": "logo: invalid base64", "body": {"display_name": "X", "logo": {"mime": "image/png", "data": "$NOT_B64"}}, "status": 400, "error": "base64"},
    {"id": "T-BR-021", "name": "sender: domain not in MAIL_SENDER_DOMAINS", "body": {"display_name": "X", "mail_from_address": "ceo@evil.test"}, "status": 400, "error": "MAIL_SENDER_DOMAINS"},
    {"id": "T-BR-022", "name": "sender: allowed domain", "body": {"display_name": "X", "mail_from_address": "News@Re-Cloud.test"}, "status": 201},
    {"id": "T-BR-023", "name": "reply-to: invalid address", "body": {"display_name": "X", "mail_reply_to": "not an address"}, "status": 400},
    {"id": "T-BR-024", "name": "footer: control characters refused", "body": {"display_name": "X", "mail_footer": {"de": "ok\u0007bell"}}, "status": 400, "error": "control"},
    {"id": "T-BR-025", "name": "origin: path refused", "body": {"display_name": "X", "origins": ["https://re-cloud.test/de"]}, "status": 400, "error": "origin"},
    {"id": "T-BR-026", "name": "origin: already another site's", "body": {"display_name": "X", "origins": ["https://simplify-erp.de"]}, "status": 400, "error": "another site"},
    {"id": "T-BR-027", "name": "text: angle brackets refused in one-line fields", "body": {"display_name": "<script>alert(1)</script>"}, "status": 422},
    {"id": "T-BR-028", "name": "redirect: http refused", "body": {"display_name": "X", "redirects": [{"flow": "lead", "locale": "de", "outcome": "error", "url": "http://re-cloud.test/x"}]}, "status": 400},
    {"id": "T-BR-029", "name": "redirect: duplicate key refused", "body": {"display_name": "X", "redirects": [{"flow": "lead", "locale": "de", "outcome": "error", "url": "https://re-cloud.test/a"}, {"flow": "lead", "locale": "de", "outcome": "error", "url": "https://re-cloud.test/b"}]}, "status": 400, "error": "duplicate"},
    {"id": "T-BR-030", "name": "unknown field refused", "body": {"display_name": "X", "script": "x"}, "status": 422},
    {"id": "T-BR-031", "name": "locale outside de / en refused", "body": {"display_name": "X", "default_locale": "fr"}, "status": 422}
  ],
  "xss": [
    {"id": "T-BR-040", "field": "display_name", "value": "Evil\" onerror=\"alert(1)", "with_logo": true, "escaped": "alt=\"Evil&quot; onerror=&quot;alert(1)\"", "raw": "onerror=\"alert(1)\""},
    {"id": "T-BR-041", "field": "wordmark", "value": "A&B \"C\" 'D'", "escaped": "A&amp;B &quot;C&quot; &#x27;D&#x27;", "raw": "A&B \"C\""},
    {"id": "T-BR-042", "field": "legal_entity", "value": "Müller & Söhne 'GmbH'", "escaped": "Müller &amp; Söhne &#x27;GmbH&#x27;", "raw": "Müller & Söhne"},
    {"id": "T-BR-043", "field": "imprint_url", "value": "https://re-cloud.test/{lang}/imprint?a=1&b=2", "escaped": "href=\"https://re-cloud.test/de/imprint?a=1&amp;b=2\"", "raw": "?a=1&b=2"}
  ],
  "route_admin": [
    {"id": "T-RT-001", "name": "subscribe: odoo list", "action": "subscribe", "targets": [{"sink": "odoo", "params": {"lists": {"newsletter": 5}}}], "status": 200},
    {"id": "T-RT-002", "name": "subscribe: odoo + webhook in order", "action": "subscribe", "targets": [{"sink": "odoo"}, {"sink": "webhook", "params": {"url": "https://flywheel.test/hooks/mauxy", "secret_ref": "flywheel"}}], "status": 200},
    {"id": "T-RT-003", "name": "unknown action", "action": "teleport", "targets": [{"sink": "odoo"}], "status": 422},
    {"id": "T-RT-004", "name": "lead: mautic not allowed", "action": "lead", "targets": [{"sink": "mautic"}], "status": 400, "error": "not allowed"},
    {"id": "T-RT-005", "name": "lead: at most one odoo target", "action": "lead", "targets": [{"sink": "odoo", "params": {"team_id": 1}}, {"sink": "odoo", "params": {"team_id": 2}}], "status": 400},
    {"id": "T-RT-006", "name": "odoo: unknown param", "action": "lead", "targets": [{"sink": "odoo", "params": {"user_id": 1}}], "status": 400, "error": "unknown"},
    {"id": "T-RT-007", "name": "odoo: list id must be a positive integer", "action": "subscribe", "targets": [{"sink": "odoo", "params": {"lists": {"newsletter": "5"}}}], "status": 400},
    {"id": "T-RT-008", "name": "odoo: subscribe takes lists only", "action": "subscribe", "targets": [{"sink": "odoo", "params": {"team_id": 3}}], "status": 400, "error": "only lists"},
    {"id": "T-RT-009", "name": "webhook: secret_ref required", "action": "unsubscribe", "targets": [{"sink": "webhook", "params": {"url": "https://flywheel.test/h"}}], "status": 400},
    {"id": "T-RT-010", "name": "webhook: secret env missing", "action": "unsubscribe", "targets": [{"sink": "webhook", "params": {"url": "https://flywheel.test/h", "secret_ref": "missing"}}], "status": 400, "error": "WEBHOOK_SECRET_MISSING"},
    {"id": "T-RT-011", "name": "webhook: secret too short", "action": "unsubscribe", "targets": [{"sink": "webhook", "params": {"url": "https://flywheel.test/h", "secret_ref": "short"}}], "status": 400, "error": "shorter"},
    {"id": "T-RT-012", "name": "webhook: http refused", "action": "unsubscribe", "targets": [{"sink": "webhook", "params": {"url": "http://flywheel.test/h", "secret_ref": "flywheel"}}], "status": 400, "error": "https only"},
    {"id": "T-RT-013", "name": "webhook: host not allow-listed", "action": "unsubscribe", "targets": [{"sink": "webhook", "params": {"url": "https://evil.test/h", "secret_ref": "flywheel"}}], "status": 400, "error": "WEBHOOK_ALLOWED_HOSTS"},
    {"id": "T-RT-014", "name": "webhook: user info refused", "action": "unsubscribe", "targets": [{"sink": "webhook", "params": {"url": "https://a@flywheel.test/h", "secret_ref": "flywheel"}}], "status": 400},
    {"id": "T-RT-015", "name": "the same receiver twice", "action": "subscribe", "targets": [{"sink": "webhook", "params": {"url": "https://flywheel.test/h", "secret_ref": "flywheel"}}, {"sink": "webhook", "params": {"url": "https://flywheel.test/h", "secret_ref": "flywheel"}}], "status": 400, "error": "twice"},
    {"id": "T-RT-016", "name": "no targets", "action": "subscribe", "targets": [], "status": 400},
    {"id": "T-RT-017", "name": "more than 10 targets", "action": "subscribe", "targets": "$ELEVEN", "status": 400},
    {"id": "T-RT-018", "name": "enabled must be boolean", "action": "subscribe", "targets": [{"sink": "odoo", "enabled": "yes"}], "status": 400},
    {"id": "T-RT-019", "name": "lead: odoo team, tags, UTM", "action": "lead", "targets": [{"sink": "odoo", "params": {"team_id": 9, "tag_ids": [3, 4], "utm_source": "re-cloud.io", "utm_medium": "Website", "utm_campaign": "webinar"}}], "status": 200},
    {"id": "T-RT-020", "name": "mautic: segment alias characters", "action": "subscribe", "targets": [{"sink": "mautic", "params": {"segment": "a b;c"}}], "status": 400},
    {"id": "T-RT-021", "name": "unknown sink", "action": "subscribe", "targets": [{"sink": "ftp"}], "status": 400}
  ],
  "ssrf": [
