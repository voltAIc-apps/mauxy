# Sinks (flywheel SPEC-021): where confirmed data goes. LEAD_SINK odoo|none, SUBSCRIBER_SINK odoo|mautic|none
# (mautic = DEPRECATED, being retired; none = nothing stored, leads go to LEAD_NOTIFY_TO by mail)
LEAD_SINK=odoo
SUBSCRIBER_SINK=odoo

# erp.wapsol (Odoo 18) -- mauxy's OWN API user (website-bot), never a personal login. Same variable
# names as the flywheel read client, different user. https only (API key travels in the body).
ODOO_URL=https://erp.wapsol.de
ODOO_DB=pwo-18-prod
ODOO_USER=
ODOO_API_KEY=
ODOO_TIMEOUT=20
# Salesperson (Ashant) res.users id, also added as follower; optional CRM team id, tag ids (comma)
ODOO_LEAD_USER_ID=
ODOO_LEAD_TEAM_ID=
ODOO_LEAD_TAG_IDS=
# UTM records are mapped by exact name (bot cannot create them); campaign name = CTA kind
# (selfcheck, contact, inquiry, webinar, checkout)
ODOO_UTM_SOURCE=simplify-erp.de
ODOO_UTM_MEDIUM=Website
# Email Marketing lists (mailing.list ids)
ODOO_LIST_NEWSLETTER_ID=
ODOO_LIST_RADAR_ID=

# CTA leads (POST /api/lead). Origins default to SELFCHECK_ALLOWED_ORIGINS; website default to
# PUBLIC_WEBSITE_BASE_URL. LEAD_NOTIFY_TO (default SELFCHECK_NOTIFY_TO) gets failed deliveries.
LEAD_ALLOWED_ORIGINS=
LEAD_WEBSITE_URL=
LEAD_RATE_LIMIT=5/minute
LEAD_NOTIFY_TO=
LEAD_PENDING_DAYS=7
LEAD_RETENTION_DAYS=30
# Outbox retries: attempts and base backoff (seconds, doubled per attempt, max 1 h)
LEAD_SYNC_MAX_ATTEMPTS=6
LEAD_SYNC_BACKOFF_SECONDS=60
SHUTDOWN_DRAIN_SECONDS=10

# DEPRECATED Mautic (only with SUBSCRIBER_SINK=mautic)
MAUTIC_BASE_URL=https://mautic.example.com
MAUTIC_USERNAME=
MAUTIC_PASSWORD=
ALLOWED_ORIGINS=https://your-app.example.com
RATE_LIMIT=5/minute
CONFIRM_RATE_LIMIT=30/minute
ACTION_LOG_DB=/data/actions.db
ADMIN_API_KEY=

# Newsletter double opt-in
# Sign the confirmation token. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CONFIRM_TOKEN_SECRET=
CONFIRM_TOKEN_MAX_AGE=86400
# Public base URL of this mauxy instance; embedded as the confirm link inside the
# Mautic email template (e.g. https://unsubscribe.engage.wapsol.de).
PUBLIC_BASE_URL=
# Public base URL of the website; confirm endpoint redirects here on success/error
# (e.g. https://simplify-erp.de). Must not include a trailing slash.
PUBLIC_WEBSITE_BASE_URL=
# Unconfirmed newsletter requests are deleted after N days; max DOI mails per address / 24h
NEWSLETTER_PENDING_DAYS=7
MAX_PENDING_PER_EMAIL=3

# Mail (DOI links, self-check result, operator notification). SMTP via mailcow
# mc1.simplify-erp.de (587 STARTTLS or 465 SSL). MAIL_MODE: smtp | console (dry run, prints) | memory (tests)
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Selbst-Check (simplify-erp.de /:lang/selbst-check, flywheel SPEC-020)
# Origins allowed to POST /api/selfcheck and /api/selfcheck/event (prod: https://simplify-erp.de;
# dev adds http://10.0.99.1:5182). Must also be in ALLOWED_ORIGINS (CORS).
SELFCHECK_ALLOWED_ORIGINS=
# Website base for the confirm redirect (/{lang}/selbst-check?bestaetigt=1); default from the rules file
SELFCHECK_WEBSITE_URL=
# Operator mailbox for "Richtangebot / Kennenlernen" notifications
SELFCHECK_NOTIFY_TO=
SELFCHECK_RATE_LIMIT=5/minute
SELFCHECK_EVENT_RATE_LIMIT=600/minute
# Retention: unconfirmed submissions / confirmed submissions (days)
SELFCHECK_PENDING_DAYS=7
SELFCHECK_RETENTION_DAYS=90
# DEPRECATED: Migration Radar in Mautic (only with SUBSCRIBER_SINK=mautic): tag, optional segment id
MAUTIC_RADAR_TAG=migration_radar_confirmed
MAUTIC_RADAR_SEGMENT_ID=
# Optional override of the vendored rules file
SELFCHECK_RULES_FILE=

# Deployment (used by scripts/deploy.py for k8s manifests)
DEPLOY_NAMESPACE=mauxy
DEPLOY_IMAGE=your-registry/mauxy:latest
DEPLOY_DOMAIN=unsubscribe.example.com
DEPLOY_IMAGE_PULL_SECRET=your-pull-secret
