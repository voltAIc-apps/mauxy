MAUTIC_BASE_URL=https://mautic.example.com
MAUTIC_USERNAME=
MAUTIC_PASSWORD=
# Target Mautic version (manual). Persisted in SQLite, shown in /health/detail, and
# resolved via get_mautic_version() for future version-specific API branching. Leave
# empty if unknown; can also be set at runtime via PUT /api/admin/mautic-instance.
MAUTIC_VERSION=
ALLOWED_ORIGINS=https://your-app.example.com
RATE_LIMIT=5/minute
ACTION_LOG_DB=/data/actions.db
# Refuse to start when the DB schema is behind the shipped db-patches/ (default true).
# Set false to start with a warning instead. Patches are applied by the deployer via
# `python scripts/sqlite_db.py --migrate` (k8s runs this as an initContainer).
MIGRATE_STRICT=true
# Bearer token for the admin endpoints (/api/actions and /api/admin/*). CRUD over
# sites + quiz + Mautic version is disabled (403) while this is unset.
ADMIN_API_KEY=

# Per-site registry. SEED ONLY: at runtime the registry lives in SQLite (sites table)
# and is managed via /api/admin/sites — this var only seeds an EMPTY DB on first boot.
# JSON array, one object per calling site. The Bearer `key` identifies the site;
# `segment` (Mautic alias) and `topic` (quiz bank) come from here, never the request body.
# Each site points at its OWN topic (see db-patches/0002_seed_quiz.sql: ludo, simplify-erp, re-cloud).
# Example:
# MAUXY_SITES=[{"key":"CHANGE-ME-ludo","site":"ludo","segment":"ludo","topic":"ludo"},{"key":"CHANGE-ME-simplify","site":"simplify-erp","segment":"simplify-erp","topic":"simplify-erp"},{"key":"CHANGE-ME-recloud","site":"re-cloud","segment":"re-cloud","topic":"re-cloud"}]
MAUXY_SITES=[]

# Secret for signing the bot-defence quiz challenge tokens (HMAC). Required for the
# quiz; if unset, challenges/(un)subscribe are disabled. CHALLENGE_TTL in seconds.
# Quiz CONTENT is seeded by a SQL patch (db-patches/0002_seed_quiz.sql), edited at runtime
# via /api/admin/quiz -- there is no quiz_bank.json anymore.
CHALLENGE_SECRET=
CHALLENGE_TTL=600

# Deployment (used by scripts/deploy.py — render/apply manifests, build/push, secret).
DEPLOY_NAMESPACE=mauxy
DEPLOY_IMAGE=your-registry/mauxy:latest
DEPLOY_DOMAIN=mauxy.engage.wapsol.de
DEPLOY_IMAGE_PULL_SECRET=your-pull-secret

# Container registry for `deploy.py --build` (docker login + build + push).
REGISTRY_URL=your-registry
REGISTRY_USER=
REGISTRY_PASSWORD=
